# Copy this file to client/.env.local and replace the Clerk placeholders.

# Use the same Clerk instance for both keys and the secret in server/.env.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_replace_me
CLERK_SECRET_KEY=sk_test_replace_me

NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Use port 8888 if running the backend with the repository's Gunicorn container.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000

# Optional overrides to use the app's own routes for Clerk redirects.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/auth/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/auth/sign-up
# Docker build argument listed by the deployment workflow.
# NEXT_PUBLIC_TMDB_BASE_IMAGE_URL=https://image.tmdb.org/t/p
