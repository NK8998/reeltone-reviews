# Copy this file to server/.env and replace the API key placeholders.

# Development uses port 5000 when started with python app.py.
APP_ENV=development
TMDB_API_KEY=replace_with_your_tmdb_api_key

# Optional. Defaults to the URL below.
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p

# Use the same Clerk secret key as in client/.env.local.
CLERK_SECRET_KEY=sk_test_replace_me
